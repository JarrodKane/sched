# Supabase Postgres connection (transaction pooler — use port 6543 for serverless)
# Found in: Supabase dashboard → Settings → Database → Connection string → Transaction
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase project URL and public anon key
# Found in: Supabase dashboard → Settings → API
PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
PUBLIC_SUPABASE_ANON_KEY="[your-anon-key]"

# Supabase service role key (server-only, never expose client-side)
# Found in: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY="[your-service-role-key]"

# Instagram / Meta app credentials for OAuth account connection
# Found in: developers.facebook.com → your app → App settings → Basic
IG_APP_ID="[your-app-id]"
IG_APP_SECRET="[your-app-secret]"
